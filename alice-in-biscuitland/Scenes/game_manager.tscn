[sub_resource type="GDScript" id="GDScript_y5gpt"]
script/source = "extends Node

const battleScene = \"res://Scenes/battle.tscn\"
const mapScene = \"res://Scenes/map.tscn\"
const biscuitRewardScene = \"res://Scenes/biscuit_rewards.tscn\"
const gameOverScene = \"res://Scenes/game_over.tscn\"
const creditsScene = \"res://Scenes/credits.tscn\"

const whiteRabbitMusic = preload(\"res://Assets/Audio/Music/Fretless.mp3\")
const madHatterMusic = preload(\"res://Assets/Audio/Music/Mischief Maker.mp3\")
const cheshireCatMusic = preload(\"res://Assets/Audio/Music/One-eyed Maestro.mp3\")
const jabberwockyMusic = preload(\"res://Assets/Audio/Music/Unlight.mp3\")
const redQueenMusic = preload(\"res://Assets/Audio/Music/Volatile Reaction.mp3\")

const mapMusic = preload(\"res://Assets/Audio/Music/map.mp3\")
const creditMusic = preload(\"res://Assets/Audio/Music/Off to Osaka.mp3\")

@onready var audio: AudioStreamPlayer = $AudioStreamPlayer
@onready var loseSound: AudioStreamPlayer2D = $\"Lose Sound\"

@export var allBiscuits : Array[Biscuit]
@export var allEnemyBiscuits : Array[Biscuit]
@export var startingBiscuits : Array[Biscuit]
var currentBiscuits : Array[int]

var enemyProgress : int
var chestProgress : Array[int]
var biscuitProgress : Array[int]
var progress : int

var mapFrame : float
var playedTutorial : bool = false
var deathMessage : String
var cardRewardMessage : String

var alicePosition : Vector2

func _ready() -> void:
	init()

func init() -> void:
	currentBiscuits.clear()
	for biscuit in startingBiscuits:
		add_biscuit(biscuit.index)
		
	audio.stream = mapMusic
	audio.play()
	SceneSwitcher.switch_scene(mapScene)

func start_battle() -> void:
	audio.stop()
	match enemyProgress:
		0:
			audio.stream = whiteRabbitMusic
		1:
			audio.stream = madHatterMusic
		2:
			audio.stream = cheshireCatMusic
		3:
			audio.stream = jabberwockyMusic
		4:
			audio.stream = redQueenMusic
	audio.play()
	SceneSwitcher.switch_scene(battleScene)
	
func end_battle() -> void:
	enemyProgress += 1
	progress += 1
	
	if enemyProgress == 5:
		audio.stream = creditMusic
		audio.play()
		SceneSwitcher.switch_scene(creditsScene)
	else:
		audio.stop()
		cardRewardMessage = \"Opponent Defeated!\"
		SceneSwitcher.switch_scene(biscuitRewardScene)
	
func found_chest() -> void:
	progress += 1
	
	audio.stop()
	cardRewardMessage = \"Chest Found!\"
	SceneSwitcher.switch_scene(biscuitRewardScene)

func chose_biscuit() -> void:
	audio.stop()
	audio.stream = mapMusic
	audio.play()
	SceneSwitcher.switch_scene(mapScene)

func lose_battle() -> void:
	loseSound.play()
	SceneSwitcher.switch_scene(gameOverScene)

func restart() -> void:
	enemyProgress = 0
	progress = 0
	chestProgress.clear()
	biscuitProgress.clear()
	init()

func add_biscuit(index : int) -> void:
	currentBiscuits.append(index)

func get_biscuit(index : int) -> Biscuit:
	return allBiscuits.get(index - 1)
	
func get_enemy_biscuit(index : int) -> Biscuit:
	return allEnemyBiscuits.get(index - 1)

func set_biscuit(biscuit1 : Biscuit, biscuit2 : Biscuit) -> void:
	biscuit1.cardName = biscuit2.cardName
	biscuit1.description = biscuit2.description
	biscuit1.dunkedDescription = biscuit2.dunkedDescription
	biscuit1.thirst = biscuit2.thirst
	biscuit1.defense = biscuit2.defense
	biscuit1.img = biscuit2.img
	biscuit1.dunkedImg = biscuit2.dunkedImg
	biscuit1.dunkedThirst = biscuit2.dunkedThirst
	biscuit1.dunkedDefense = biscuit2.dunkedDefense
	biscuit1.index = biscuit2.index
	biscuit1.dunkable = biscuit2.dunkable
	biscuit1.enemyPlayable = biscuit2.enemyPlayable
	biscuit1.playerPlayable = biscuit2.playerPlayable
	biscuit1.update_sprites()
"

